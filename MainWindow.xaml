<Window x:Class="NetworkAnalyzer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Анализатор сетевых подключений" 
        Height="700" Width="900"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Сетевые интерфейсы -->
        <GroupBox Grid.Row="0" Header="Сетевые интерфейсы" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ListBox x:Name="lbInterfaces" Grid.Column="0" 
                         Height="150" SelectionChanged="lbInterfaces_SelectionChanged"/>

                <Grid Grid.Column="1" Margin="10,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Имя:" Margin="0,0,10,5"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="txtName" Margin="0,0,0,5"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="IP-адрес:" Margin="0,0,10,5"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtIp" Margin="0,0,0,5"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Маска:" Margin="0,0,10,5"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="txtMask" Margin="0,0,0,5"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="MAC-адрес:" Margin="0,0,10,5"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="txtMac" Margin="0,0,0,5"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Статус:" Margin="0,0,10,5"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="txtStatus" Margin="0,0,0,5"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Тип/Скорость:" Margin="0,0,10,5"/>
                    <TextBlock Grid.Row="5" Grid.Column="1" x:Name="txtTypeSpeed" Margin="0,0,0,5"/>
                </Grid>
            </Grid>
        </GroupBox>

        <!-- Анализ URL -->
        <GroupBox Grid.Row="1" Header="Анализ URL/URI" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="txtUrl" Grid.Column="0" 
                             Height="30" Margin="0,0,10,0"
                             Text="https://www.example.com/path?query=1"/>
                    <Button Grid.Column="1" Content="Анализировать" 
                            Width="100" Height="30" Margin="0,0,10,0"
                            Click="btnAnalyze_Click"/>
                    <Button Grid.Column="2" Content="Ping" 
                            Width="60" Height="30"
                            Click="btnPing_Click"/>
                </Grid>

                <ListBox x:Name="lbUrlResults" Grid.Row="1" 
                         Height="150" Margin="0,10,0,0"/>
            </Grid>
        </GroupBox>

        <!-- Дополнительная информация -->
        <GroupBox Grid.Row="2" Header="Дополнительная информация" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock x:Name="txtDnsInfo" Text="DNS: " FontWeight="Bold"/>
                    <TextBlock x:Name="txtAddressType" Text="Тип адреса: " Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Content="Очистить историю" Width="120" Height="30"
                            Click="btnClearHistory_Click"/>
                    <Button Content="Обновить интерфейсы" Width="130" Height="30" Margin="10,0,0,0"
                            Click="btnRefresh_Click"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- История -->
        <GroupBox Grid.Row="3" Header="История проверок">
            <ListView x:Name="lvHistory">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="URL" DisplayMemberBinding="{Binding Url}" Width="400"/>
                        <GridViewColumn Header="Доступность" DisplayMemberBinding="{Binding IsAvailable}" Width="100"/>
                        <GridViewColumn Header="Время" DisplayMemberBinding="{Binding CheckedAt}" Width="200"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </GroupBox>
    </Grid>
</Window>